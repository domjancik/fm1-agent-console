{
  "//": "The Traycer integration test imports the adapter package's sources and the vendored protocol, which are written for strict TS without noUncheckedIndexedAccess (same settings as packages/agent-adapter-traycer).",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["bun"],
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "paths": {
      "@traycer-clients/shared/*": ["../../vendor/traycer/clients-shared/*"],
      "@traycer/protocol/utils/*": ["../../vendor/traycer/protocol/utils/*"],
      "@traycer/protocol/*": ["../../vendor/traycer/protocol/src/*"]
    }
  },
  "files": ["test/traycer-integration.test.ts"]
}
