{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["bun"],
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "paths": {
      "@traycer-clients/shared/*": ["../../vendor/traycer/clients-shared/*"],
      "@traycer/protocol/utils/*": ["../../vendor/traycer/protocol/utils/*"],
      "@traycer/protocol/*": ["../../vendor/traycer/protocol/src/*"]
    }
  },
  "include": ["src", "test", "scripts"]
}
