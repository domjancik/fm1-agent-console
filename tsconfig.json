{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": [
      "bun"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ],
    "paths": {
      "@fm1/agent-adapter-traycer": [
        "packages/agent-adapter-traycer/src/index.ts"
      ],
      "@traycer-clients/shared/*": [
        "vendor/traycer/clients-shared/*"
      ],
      "@traycer/protocol/utils/*": [
        "vendor/traycer/protocol/utils/*"
      ],
      "@traycer/protocol/*": [
        "vendor/traycer/protocol/src/*"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "packages/*/src",
    "apps/*/src",
    "tools/*/src",
    "packages/*/test",
    "apps/*/test",
    "tools/*/test"
  ]
}
